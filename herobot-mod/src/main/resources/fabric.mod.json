{
  "schemaVersion": 1,
  "id": "herobot",
  "version": "${version}",
  "name": "HeroBot",
  "description": "Robots scripted to be Heroes (unofficial 26.3 port, server-side only - the AI editor screen is not included)",
  "authors": [
    "HerobaneNair"
  ],
  "contact": {},
  "license": "CC-BY-NC-SA-4.0",
  "icon": "assets/herobot/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "hero.bane.herobot.mod.common.carpet.CarpetCompat"
    ],
    "main": [
      "hero.bane.herobot.mod.common.HeroBot"
    ],
    "voicechat": [
      "hero.bane.herobot.common.voice.HeroVoicePlugin"
    ]
  },
  "mixins": [
    "herobot.mixins.json",
    "herobot.carpet.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}"
  },
  "suggests": {
    "voicechat": ">=2.5.0"
  },
  "breaks": {
    "carpetpvp": "*"
  }
}
